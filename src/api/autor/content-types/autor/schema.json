{
  "kind": "collectionType",
  "collectionName": "autors",
  "info": {
    "singularName": "autor",
    "pluralName": "autors",
    "displayName": "✍️ Autores"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string"
    },
    "foto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cargo": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "nome"
    },
    "noticias": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::noticia.noticia",
      "mappedBy": "autor"
    }
  }
}
