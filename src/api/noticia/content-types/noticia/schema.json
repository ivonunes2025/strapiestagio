{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "📰 Notícias"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string"
    },
    "conteudo": {
      "type": "blocks"
    },
    "capa": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "categorias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::categoria.categoria",
      "mappedBy": "noticias"
    },
    "destaque": {
      "type": "boolean",
      "default": false
    },
    "Privadas": {
      "type": "boolean",
      "default": false
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::autor.autor",
      "inversedBy": "noticias"
    },
    "visivel": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "noticias"
    },
    "titulo_ingles": {
      "type": "string"
    },
    "conteudo_ingles": {
      "type": "blocks"
    },
    "slug_ingles": {
      "type": "uid",
      "targetField": "titulo_ingles"
    }
  }
}