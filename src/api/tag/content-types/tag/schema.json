{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "🏷️Tag"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome"
    },
    "noticias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::noticia.noticia",
      "mappedBy": "tags"
    }
  }
}
