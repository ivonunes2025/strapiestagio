{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "🗂️ Categorias"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "nome"
    },
    "ordem": {
      "type": "integer",
      "default": 999
    },
    "noticias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::noticia.noticia",
      "private": true,
      "inversedBy": "categorias"
    }
  }
}
